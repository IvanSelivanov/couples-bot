# Copy to .env and fill in. .env never goes into git.

# Bot token from @BotFather.
BOT_TOKEN=
# Bot username without @, used to recognise mentions of the bot in the group (DR23).
BOT_USERNAME=
# Webhook secret (setWebhook secret_token). Required: without it the webhook
# answers 403 to everything. Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Supabase. Locally, `npm run db:start` prints both values
# (API_URL and SERVICE_ROLE_KEY). In production: project settings, the service_role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Gemini. Key from Google AI Studio (free tier; see README about data use).
GEMINI_API_KEY=
# Daily model request limit on the free tier; the 70/90/100% tiers are counted from it.
GEMINI_DAILY_LIMIT=500
# Gemini model for all calls. Empty means the default from lib/gemini.js.
# On the free tier every model has its own quota (AI Studio → Rate Limit).
GEMINI_MODEL=

# Evals (npm run eval): a separate key, so evals don't spend the bot's quota.
EVAL_GEMINI_API_KEY=

# Private chat encryption: 32 bytes in base64. Generate:
#   node -e "import('./lib/crypto.js').then(m=>console.log(m.generateKey()))"
# Rotation: old key → DM_ENCRYPTION_KEY_PREV, new → DM_ENCRYPTION_KEY,
# version +1. Lost key = lost private chats; keep it outside the repo.
DM_ENCRYPTION_KEY=
DM_ENCRYPTION_KEY_VERSION=1
DM_ENCRYPTION_KEY_PREV=

# Vercel cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Name of the person running the bot, shown in the consent text (DR7): who can technically read private chats.
ADMIN_NAME=

# Guest Mode spike: delay before answerGuestQuery, ms.
SPIKE_DELAY_MS=0
