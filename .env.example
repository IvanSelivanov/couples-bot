# Copy to .env and fill in. .env never goes into git.
# Only needed for a command-line setup or local runs; the Deploy button asks for
# the four required values itself (see README).

# Required. Bot token from @BotFather.
BOT_TOKEN=
# Optional. Bot username without @ (DR23); empty means it's asked from Telegram (getMe).
BOT_USERNAME=
# Optional. Webhook secret (setWebhook secret_token); empty means it's derived from
# BOT_TOKEN. Set it only if you want it independent of the token.
WEBHOOK_SECRET=

# Supabase. Locally, `npm run db:start` prints both values
# (API_URL and SERVICE_ROLE_KEY). In production they go to .env.production:
# SUPABASE_URL, SUPABASE_SERVICE_KEY (service_role or sb_secret_ key) and
# SUPABASE_DB_URL (session pooler connection string, used by the build to run migrations).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Required. Gemini key from Google AI Studio (free tier; see README about data use).
GEMINI_API_KEY=
# Daily model request limit on the free tier; the 70/90/100% tiers are counted from it.
GEMINI_DAILY_LIMIT=500
# Gemini model for all calls. Empty means the default from lib/gemini.js.
# On the free tier every model has its own quota (AI Studio → Rate Limit).
GEMINI_MODEL=

# Evals (npm run eval): a separate key, so evals don't spend the bot's quota.
EVAL_GEMINI_API_KEY=

# Required. Private chat encryption: a passphrase of 16+ characters, or a raw key
# (32 bytes in base64): node -e "import('./lib/crypto.js').then(m=>console.log(m.generateKey()))"
# Rotation: old → DM_ENCRYPTION_KEY_PREV, new → DM_ENCRYPTION_KEY, version +1.
# Lost key = lost private chats; keep it outside the repo.
DM_ENCRYPTION_KEY=
DM_ENCRYPTION_KEY_VERSION=1
DM_ENCRYPTION_KEY_PREV=

# Optional. With it, only Vercel's cron (Authorization: Bearer <CRON_SECRET>) may run
# maintenance; without it, /api/cron runs at most once per 20 hours.
CRON_SECRET=
# Required. Name of the person running the bot, shown in the consent text (DR7):
# who can technically read private chats.
ADMIN_NAME=

# Guest Mode spike: delay before answerGuestQuery, ms.
SPIKE_DELAY_MS=0
