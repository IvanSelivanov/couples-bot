# Скопируй в .env и заполни. .env в git не попадает.

# Токен бота от @BotFather. Бот новый, не тот, что в tgbot.
BOT_TOKEN=
# Имя бота без @ — чтобы узнавать обращения к нему в группе (DR23).
BOT_USERNAME=
# Секрет вебхука (setWebhook secret_token). Обязателен: без него вебхук
# отвечает 403 на всё. Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=

# Supabase. Локально: `npm run db:start` печатает оба значения
# (API_URL и SERVICE_ROLE_KEY). В проде — из настроек проекта, ключ service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Gemini. Ключ из Google AI Studio (free tier, см. дизайн-док про условия).
GEMINI_API_KEY=
# Дневной лимит запросов модели на free tier; от него считаются уровни 70/90/100%.
GEMINI_DAILY_LIMIT=500

# Шифрование лички: 32 байта в base64. Сгенерировать:
#   node -e "import('./lib/crypto.js').then(m=>console.log(m.generateKey()))"
# Ротация: старый ключ → DM_ENCRYPTION_KEY_PREV, новый → DM_ENCRYPTION_KEY,
# версию +1. Потерянный ключ = потерянная личка, храни его вне репо.
DM_ENCRYPTION_KEY=
DM_ENCRYPTION_KEY_VERSION=1
DM_ENCRYPTION_KEY_PREV=

# Спайк Guest Mode: задержка перед answerGuestQuery, мс.
SPIKE_DELAY_MS=0
